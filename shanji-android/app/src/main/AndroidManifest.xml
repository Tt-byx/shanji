<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- AI 识别需要联网（v1.2 修复：v1.1 漏声明导致识别必定失败） -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- 语音记账：系统 SpeechRecognizer 免费识别，需要麦克风权限 -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <!-- 主动式 AI 推送（周报 / 超支预警 / 到期提醒）需要通知权限（Android 13+ 运行时申请） -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!-- Android 11+ 包可见性：不声明就查不到系统的语音识别服务 -->
    <queries>
        <intent>
            <action android:name="android.speech.RecognitionService" />
        </intent>
    </queries>

    <application
        android:label="闪记"
        android:icon="@mipmap/ic_launcher"
        android:supportsRtl="true"
        android:usesCleartextTraffic="true"
        android:theme="@style/Theme.ShanJi">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 分享入口：任意 App（含系统截图分享）把图片/文本分享给闪记 -->
        <activity
            android:name=".ShareCaptureActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:taskAffinity=""
            android:theme="@style/Theme.ShanJi">
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="image/*" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>

        <!-- 主动式 AI 推送：AlarmManager 闹钟 → 周报 / 超支预警 / 订阅到期通知 -->
        <receiver
            android:name=".data.AiAlarmReceiver"
            android:exported="false" />

        <!-- 桌面小组件：本月/今日支出 + 预算进度 -->
        <receiver
            android:name=".ui.widget.ShanjiWidgetProvider"
            android:exported="false">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_info" />
        </receiver>
    </application>
</manifest>
